{
  "name": "@art-lib/operations",
  "version": "0.0.2",
  "description": "Operation outcome types and factories, and an append-only operations log that forwards every operation to the logger.",
  "keywords": [
    "library",
    "operations",
    "cli",
    "tooling",
    "art",
    "terminal-apps"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/art-lib.git",
    "directory": "libs/operations"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.mjs"
    },
    "./log": {
      "types": "./dist/log/index.d.ts",
      "import": "./dist/log/index.mjs"
    }
  },
  "scripts": {
    "dev": "esbuild-cli-watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "esbuild-cli",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@art-lib/logger": "0.0.1"
  },
  "devDependencies": {}
}
