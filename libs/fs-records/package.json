{
  "name": "@art-lib/fs-records",
  "version": "0.0.1",
  "description": "Generic Art MD record read/write modules for CLIs.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "README.md"
  ],
  "scripts": {
    "dev": "esbuild-cli-watch",
    "build:clean": "rm -rf dist",
    "build:types:esm": "tsc --project tsconfig.esm.json",
    "build:types:cjs": "tsc --project tsconfig.cjs.json",
    "build": "esbuild-cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "ci": "npm run lint && npm run build && npm run test"
  },
  "devDependencies": {
    "@noodlestan/esbuild": "^0.0.13",
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.0",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
